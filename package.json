{
  "name": "lampwarden",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "bun run lint && bun run typecheck && bun test && bun run knip && bun run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p .",
    "knip": "knip",
    "verify:visual": "bun e2e/verify-visual.mjs",
    "walkthrough": "bun e2e/walkthrough.ts",
    "balance": "bun scripts/balance.ts",
    "plays": "bun scripts/plays.ts",
    "assets": "bun --no-env-file pipeline/run.ts",
    "kit": "bun pipeline/assemble-kit.ts",
    "assets:hero": "bun --no-env-file pipeline/hero-frames.ts",
    "render": "bun --no-env-file pipeline/render-file.ts",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0; lefthook install",
    "logo": "bun tools/logo/build.ts",
    "check:pixels": "bun pipeline/check-pixels.ts"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "@vercel/blob": "^2.8.2",
    "next": "^16.4.3",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@boatdev/sdk": "1.11.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/sandbox": "3.9.0",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
