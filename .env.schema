# Every environment variable Lampwarden reads. This file is the single source of truth: names, types, which are
# required where, and which are secret. It holds no values for secrets and is committed.
#
# Where values come from, lowest to highest precedence: defaults in this file, `.env.local` (git-ignored; keys for local
# work, see docs/tooling.md "Environment"), then the process environment (Vercel project settings, or your shell).
#
# Secure by default: an item is sensitive unless it says @public, so a new variable never reaches a log, a client bundle
# or a response until someone decides it may. Sensitive values need at least 12 characters, or redaction cannot hide them.
#
# @currentEnv=$APP_ENV
# @defaultSensitive=true
# @defaultRequired=false
# @generateTsTypes(path=./env.d.ts, icons=false)
# Vercel builds carry the resolved env encrypted with _VARLOCK_ENV_KEY (a sensitive Vercel variable); without the key a
# preview or production build fails instead of shipping secrets as plaintext.
# @encryptInjectedEnv=forEnv(preview, production)
# ---

# --- Which environment this is ---

# Set by Vercel on every build and deployment; empty everywhere else.
# @type=enum(development, preview, production) @public
VERCEL_ENV=

# The environment flag. Vercel's name for it, else development. To check what production would demand, run a command
# as `APP_ENV=production bun run build` (it then needs the keys below).
# @type=enum(development, preview, production) @public
APP_ENV=fallback($VERCEL_ENV, development)

# The commit a deployment was built from, set by Vercel; /api/plays records its first 7 characters as the play's build.
# @public
VERCEL_GIT_COMMIT_SHA=

# --- Recorded plays and the creature gallery (a private Vercel Blob store) ---

# Read by @vercel/blob in the plays and creature routes, and by `bun run plays`. Without it nothing can be stored.
# `vercel env pull .env.local` writes it for local work.
# @sensitive @required=forEnv(preview, production) @type=string(startsWith=vercel_blob_rw_)
# @docs(https://vercel.com/docs/vercel-blob)
BLOB_READ_WRITE_TOKEN=

# --- Live creatures (/api/creatures) and the offline sprite pipeline ---
# Without all three of MUBIT_API_KEY, VERCEL_SANDBOX_SNAPSHOT_ID and CREATURE_RATE_SALT the gallery is still served and
# no creature is generated (src/server/creatures/config.ts, generationAvailable). That is why a local run needs none of
# them, and why a preview or production deployment must have them.

# The Mubit key the brief writer, generator and verifier call https://api.mubit.ai with; `bun run assets` and
# `bun run calibrate:verifier` read it too. Never printed, logged or committed.
# @sensitive @required=forEnv(preview, production) @tag(pipeline)
MUBIT_API_KEY=

# The Vercel Sandbox snapshot every render boots from, printed by `bun run sandbox:snapshot`: the live creature jobs and
# the pipeline (`bun run assets`, `check:pixels`, `assets:hero`) alike. Rebuild it whenever pipeline/kit/kit.ts or
# pipeline/render/ changes; a render with a stale one fails and says so.
# @public @required=forEnv(preview, production) @tag(pipeline)
VERCEL_SANDBOX_SNAPSHOT_ID=

# Keys the per-visitor and daily creature limits (a hash of address and salt, never the address). At least 16 random
# characters, for example `openssl rand -hex 24`; a shorter one is rejected here (the code alone would only turn
# generation off). Changing it resets the counts.
# @sensitive @required=forEnv(preview, production) @type=string(minLength=16)
CREATURE_RATE_SALT=

# The limits below are digits only. A malformed one is rejected here; src/server/creatures/config.ts keeps the defaults
# (12 and 40 starts, 3 candidates, the prefix below) and still falls back to them for a value that is simply unset.

# Creature jobs one visitor may start per hour. Default 12.
# @public @type=string(matches=regex("^[0-9]+$"))
CREATURE_MAX_STARTS_PER_VISITOR_PER_HOUR=

# Creature jobs all visitors together may start per day. Default 40.
# @public @type=string(matches=regex("^[0-9]+$"))
CREATURE_MAX_STARTS_PER_DAY=

# Candidate sprites a job draws side by side from one brief; more than 5 counts as 5. Default 3.
# @public @type=string(matches=regex("^[0-9]+$"))
CREATURE_CANDIDATES=

# Where in the Blob store the creature gallery, jobs and limit marks live. Default creatures.
# @public @type=string(matches=regex("^[a-z0-9][a-z0-9/_-]{0,60}$"))
CREATURE_BLOB_PREFIX=

# Development only: a directory where a job leaves every candidate sprite and a score summary, accepted or not.
# @public
CREATURE_DEBUG_DIR=

# --- Vercel Sandbox credentials (@vercel/sandbox, for every render: `bun run sandbox:snapshot`, `assets`, `check:pixels`) ---
# On Vercel the function authenticates with the platform's own OIDC token, which arrives with the request, so nothing
# needs setting there. Locally the SDK takes VERCEL_OIDC_TOKEN from `vercel env pull .env.local`, or refreshes one from
# the Vercel CLI login of a `vercel link`ed project. The model-written build code never sees it: the sandbox gets KIT_OUT
# only.

# @sensitive @tag(pipeline)
# @docs(https://vercel.com/docs/oidc)
VERCEL_OIDC_TOKEN=

# --- The build ---

# The fingerprint of the sources that decide how a night plays out: 12 hex digits, computed by next.config.ts at build
# time (tools/sim-fingerprint) and inlined into the client and server bundles. Every recorded play carries it. Never set
# it by hand; it is declared so the schema lists every variable the code reads.
# @public @type=string(matches=regex("^[0-9a-f]{12}$"))
NEXT_PUBLIC_SIM_FINGERPRINT=

# --- The live director (/api/director, src/server/director) ---
# It calls Mubit with MUBIT_API_KEY and reads and writes the Blob store with BLOB_READ_WRITE_TOKEN. Without the key or a
# salt every answer is the rules' (src/server/director/config.ts), so nothing here is required.

# Keys the director's per-visitor and daily limits; CREATURE_RATE_SALT keys them when this is unset. At least 16
# characters; a shorter one is rejected here.
# @sensitive @type=string(minLength=16)
DIRECTOR_RATE_SALT=

# Director calls one visitor may make per hour. Default 40.
# @public @type=string(matches=regex("^[0-9]+$"))
DIRECTOR_MAX_CALLS_PER_VISITOR_PER_HOUR=

# Director calls all visitors together may make per day. Default 2000.
# @public @type=string(matches=regex("^[0-9]+$"))
DIRECTOR_MAX_CALLS_PER_DAY=

# Where in the Blob store the director logs decisions and limit marks. Default director.
# @public @type=string(matches=regex("^[a-z0-9][a-z0-9/_-]{0,60}$"))
DIRECTOR_BLOB_PREFIX=

# Where the director reads recorded plays from, the store /api/plays writes. Default plays.
# @public @type=string(matches=regex("^[a-z0-9][a-z0-9/_-]{0,60}$"))
DIRECTOR_PLAYS_PREFIX=

# Not declared on purpose: KIT_OUT (set by the renderer for its own batch driver inside the sandbox).
