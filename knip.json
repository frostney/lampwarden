{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.{ts,mjs}", "tools/**/build.ts", "e2e/**/*.{ts,mjs}"],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.ts",
    "scripts/**/*.{ts,mjs}",
    "tools/**/*.ts",
    "e2e/**/*.{ts,mjs}"
  ],
  "ignore": ["pipeline/**", "public/sprites/**"]
}
