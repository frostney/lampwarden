# Copy to .env.local (git-ignored) or export in your shell. Never commit a real key.
MUBIT_API_KEY=your-mubit-key-here
# Rendering (bun run assets, check:pixels, assets:hero) runs in Vercel Sandbox: `vercel link` once, then export the
# snapshot id that `bun run sandbox:snapshot` prints. The pipeline commands run under `bun --no-env-file`, so export
# it in your shell; see docs/tooling.md, "Rendering needs Vercel auth".
# VERCEL_SANDBOX_SNAPSHOT_ID=snap_...
# Live creatures (/api/creatures): set on the Vercel project, not in a file; see README "Deploying"
# CREATURE_RATE_SALT=at-least-16-random-characters
# CREATURE_MAX_STARTS_PER_VISITOR_PER_HOUR=3
# CREATURE_MAX_STARTS_PER_DAY=40
# CREATURE_BLOB_PREFIX=creatures
# CREATURE_CANDIDATES=3
# CREATURE_DEBUG_DIR=/tmp/creature-debug   (local development only)
