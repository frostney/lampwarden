{
  "name": "lampwarden",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "bun run lint && bun run typecheck && bun test && bun run knip && bun run scan && bun run check:generated && bun run build",
    "check:generated": "bun pipeline/assemble-kit.ts --check && bun tools/logo/build.ts --check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "varlock codegen && tsc --noEmit -p .",
    "knip": "varlock run --inject blob -- knip",
    "scan": "varlock scan",
    "verify:visual": "bun e2e/verify-visual.mjs",
    "walkthrough": "bun e2e/walkthrough.ts",
    "balance": "bun scripts/balance.ts",
    "plays": "varlock run --inject vars --filter=BLOB_READ_WRITE_TOKEN -- bun --no-env-file scripts/plays.ts",
    "assets": "varlock run --inject vars --filter=#pipeline -- bun --no-env-file pipeline/run.ts",
    "kit": "bun pipeline/assemble-kit.ts",
    "sandbox:snapshot": "varlock run --inject vars --filter=VERCEL_OIDC_TOKEN -- bun --no-env-file pipeline/sandbox-snapshot.ts",
    "calibrate:verifier": "varlock run --inject vars --filter=MUBIT_API_KEY,VERCEL_SANDBOX_SNAPSHOT_ID,VERCEL_OIDC_TOKEN -- bun --no-env-file pipeline/calibrate-verifier.ts",
    "reverify:sprites": "varlock run --inject vars --filter=#pipeline -- bun --no-env-file pipeline/reverify.ts",
    "assets:hero": "varlock run --inject vars --filter=VERCEL_SANDBOX_SNAPSHOT_ID,VERCEL_OIDC_TOKEN -- bun --no-env-file pipeline/hero-frames.ts",
    "render": "varlock run --inject vars --filter=VERCEL_SANDBOX_SNAPSHOT_ID,VERCEL_OIDC_TOKEN -- bun --no-env-file pipeline/render-file.ts",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0; lefthook install",
    "logo": "bun tools/logo/build.ts",
    "decor": "bun tools/decor-extents/build.ts",
    "check:pixels": "varlock run --inject vars --filter=VERCEL_SANDBOX_SNAPSHOT_ID,VERCEL_OIDC_TOKEN -- bun --no-env-file pipeline/check-pixels.ts"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "@varlock/nextjs-integration": "^1.2.5",
    "@vercel/blob": "^2.8.2",
    "@vercel/sandbox": "3.9.0",
    "next": "^16.4.3",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "varlock": "^1.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration"
  },
  "packageManager": "bun@1.4.4"
}
